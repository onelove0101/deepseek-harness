#!/usr/bin/env bash
# Start `pnpm dsh web` from the dsh repo; stop a running instance first.
set -u

REPO="/Users/jdong/iproject/dsh"
PATTERN='apps/cli/src/bin\.ts web|pnpm dsh web'

if pgrep -f "$PATTERN" >/dev/null; then
  echo "dh-web: stopping running instance..."
  pkill -TERM -f "$PATTERN"
  for _ in $(seq 1 50); do
    pgrep -f "$PATTERN" >/dev/null || break
    sleep 0.2
  done
  if pgrep -f "$PATTERN" >/dev/null; then
    echo "dh-web: still running after 10s, sending SIGKILL"
    pkill -KILL -f "$PATTERN"
    sleep 0.5
  fi
fi

cd "$REPO" || exit 1
echo "dh-web: starting pnpm dsh web"
exec pnpm dsh web "$@"
